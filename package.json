{
  "name": "zenith-community",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Zenith Community - self-hosted website monitoring and audits",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply zenith-community --local",
    "db:migrate:remote": "wrangler d1 migrations apply zenith-community --remote",
    "cf:typegen": "wrangler types --env-interface CloudflareBindings ./src/worker-configuration.d.ts",
    "deploy": "npm run build && wrangler deploy",
    "visual:review": "node scripts/visual-review.mjs",
    "perf:before": "node scripts/perf-measure.mjs before",
    "perf:after": "node scripts/perf-measure.mjs after",
    "polish:before": "node scripts/polish-capture.mjs before",
    "polish:after": "node scripts/polish-capture.mjs after",
    "polish:diff": "node scripts/polish-diff.mjs",
    "dashboard:before": "node scripts/dashboard-capture.mjs before",
    "dashboard:after": "node scripts/dashboard-capture.mjs after",
    "dev:smoke": "node scripts/dev-smoke.mjs",
    "preview:smoke": "node scripts/dev-smoke.mjs http://localhost:4173",
    "test:e2e:preview": "playwright test --config=playwright.preview.config.ts"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.2.7",
    "hono": "^4.7.7",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.0.12",
    "@cloudflare/workers-types": "^5.20260908.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.12.0"
  },
  "overrides": {
    "basic-ftp": "6.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
